# Copy to .env.local for local development, and set the same keys in Vercel.

# --- Jupiter (server-side only, never exposed to the browser) ---
# Key from https://developers.jup.ag/portal. The limit is shared by all visitors
# (it applies per organisation): keyless 0.5 req/s is for local dev, the Free key
# (1 req/s) suits a few users, real traffic needs Developer (10 req/s) or higher.
JUPITER_API_KEY=

# Optional integrator fee via the Jupiter Referral Program. Set both or neither.
# Create the referral account (and a referral token account per fee mint, at least
# SOL and USDC) at https://referral.jup.ag/. Fee is in basis points, 50-255.
JUPITER_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=

# --- Solana RPC (exposed to the browser) ---
# Used for wallet balances. The public endpoint is heavily rate-limited; use a
# provider such as Helius and restrict the key to your domains in its dashboard.
NEXT_PUBLIC_HELIUS_RPC_URL=https://api.mainnet-beta.solana.com

# --- Optional ---
# Mint address of the DEGN token; adds it to the swap token list when set.
NEXT_PUBLIC_DEGN_MINT=

# --- Trade terminal market data (server-side only) ---
# Free CoinGecko Demo key (https://www.coingecko.com/en/api) for on-chain candles
# and trades: 100 calls/min. Empty = keyless GeckoTerminal (~10 calls/min per IP).
CG_DEMO_API_KEY=

# --- Limit orders and DCA (Jupiter Trigger API v2, beta) ---
# Kill switch. 1 (or new) = pause new orders, keep cancel/withdraw working.
# all = switch everything off and point users to jup.ag. Needs a redeploy.
NEXT_PUBLIC_DISABLE_TRIGGER=
